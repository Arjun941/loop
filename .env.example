# ── Supabase (https://supabase.com/dashboard → your project) ─────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=
# Connect → Transaction pooler (port 6543), with your database password.
# Not the session pooler (5432): it caps total connections, which serverless instances quickly use up.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Optional: connections per server instance (default 10).
# DB_POOL_MAX=

# ── App ──────────────────────────────────────────────────────────────────────
# Public URL of the app, used for links in emails and auth redirects
APP_URL=http://localhost:3000

# Transactional emails (quotes, invoices) via Resend. Without a key they stay in the in-app Outbox.
RESEND_API_KEY=
EMAIL_FROM="Loop <onboarding@resend.dev>"

# Protects /api/cron/daily (nightly billing + reminders). Any long random string.
CRON_SECRET=
